{
  "kind": "HoneycombChart",
  "spec": {
    "calculation": "last",
    "nameLabel": "pod",
    "groupBy": "namespace",
    "stateLabel": "reason",
    "mappings": [
      {
        "kind": "Value",
        "spec": {
          "value": "CrashLoopBackOff",
          "result": { "value": "CrashLoop", "color": "#d32f2f" }
        }
      }
    ],
    "thresholds": {
      "mode": "percent",
