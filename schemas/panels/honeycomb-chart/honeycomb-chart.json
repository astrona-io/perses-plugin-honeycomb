        { "value": 70, "color": "#ed6c02" },
        { "value": 90, "color": "#d32f2f" }
      ]
    },
    "format": { "unit": "percent-decimal" },
    "shape": "hexagon",
    "sort": "severity",
    "showValues": true,
    "showLegend": true
  }
}
